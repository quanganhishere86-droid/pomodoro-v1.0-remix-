{
  "name": "pomofruti",
  "productName": "Pomofruti",
  "description": "A beautiful Pomodoro timer application",
  "author": {
    "name": "Pomofruti. Inc"
  },
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js release",
    "lint": "tsc --noEmit",
    "package-win": "npm run build && electron-builder --win",
    "package-linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-player": "^3.4.0",
    "react-youtube": "^10.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-youtube": "^7.10.0",
    "autoprefixer": "^10.4.21",
    "electron": "^32.1.2",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.pomofruti.app",
    "productName": "Pomofruti",
    "copyright": "Copyright © 2026 Pomofruti. Inc. All rights reserved.",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "publisherName": "Pomofruti. Inc"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": true
    },
    "directories": {
      "output": "release",
      "buildResources": "public"
    }
  }
}
